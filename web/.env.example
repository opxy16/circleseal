# Copy to .env.local and fill in. Never commit .env.local.

# Which network the app talks to: localhost | qieTestnet | qieMainnet
NEXT_PUBLIC_NETWORK=localhost

# Optional RPC overrides
NEXT_PUBLIC_QIE_TESTNET_RPC=https://rpc1testnet.qie.digital
NEXT_PUBLIC_QIE_MAINNET_RPC=https://rpc1mainnet.qie.digital

# SERVER ONLY: the relayer wallet that pays gas for members. Use a dedicated wallet
# holding only a little QIE for gas. Never put a personal wallet's key here.
RELAYER_PRIVATE_KEY=
