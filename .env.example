# Copy this file to .env and fill it in yourself. Never share or commit .env.
# Use a FRESH wallet that holds only test funds (and later a small amount of mainnet QIE for gas).
DEPLOYER_PRIVATE_KEY=

# Public RPCs from docs.qie.digital (rpc2..rpc5 also exist if one is down).
QIE_TESTNET_RPC=https://rpc1testnet.qie.digital
QIE_MAINNET_RPC=https://rpc1mainnet.qie.digital

# Mainnet only: the real QUSDC used by circle mode (6 decimals, no permit), from qie.digital/developers.
QUSDC_ADDRESS=0x3F43DA82eC9A4f5285F10FaF1F26EcA7319E5DA5
